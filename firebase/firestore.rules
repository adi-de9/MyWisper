rules_version = '2';
// Each signed-in user can read and write only their own data: users/{uid}/...
// usage/{uid}/days/{day}: today's free-limit counter, written only by the server (Cloud Functions); the owner may read it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /usage/{uid}/days/{day} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
